diff --git a/src/stores/gameStore.test.ts b/src/stores/gameStore.test.ts
index 5a2c644..ac08039 100644
--- a/src/stores/gameStore.test.ts
+++ b/src/stores/gameStore.test.ts
@@ -336,6 +336,52 @@ describe('safe browser persistence', () => {
     expect(game.saveError).toBe('')
     expect(game.speed).toBe(20)
   })
+  it('archives oversized legacy pending intact when the checkpoint fits quota', async () => {
+    const appended: playJournal.PlayRecord[] = []
+    const appendBatch = vi.fn(async (batch: playJournal.PlayRecord[]) => { appended.push(...structuredClone(batch)) })
+    vi.spyOn(playJournal, 'createPlayJournal').mockReturnValueOnce({ appendBatch, readAll: async () => [] })
+    const world = createGame(100016); world.life.openingSeen = true
+    // Controlled legacy fixture: older checkpoints accept pending messages above the current cap.
+    const envelope = JSON.parse(serialize(world, 100000))
+    envelope.playJournal = { version: 1, worldId: 'legacy-world', pending: [{ id: 'legacy-large', worldId: 'legacy-world', at: 100000,
+      kind: 'action', from: 480, to: 480, characterId: world.activeCharacterId, message: 'x'.repeat(400_000), events: [] }] }
+    saved = JSON.stringify(envelope)
+    storage.setItem.mockImplementation((_key, value) => {
+      if (value.length > 5_000_000) throw new DOMException('localStorage quota exceeded', 'QuotaExceededError')
+      saved = value
+    })
+    const game = useGameStore()
+    await vi.advanceTimersByTimeAsync(0)
+    expect(appended.map(record => record.id)).toEqual(['legacy-large'])
+    expect(appended).toEqual(envelope.playJournal.pending)
+    expect(game.pendingRecords).toBe(0)
+    expect(game.saveError).toBe('')
+    expect(game.journalError).toBe('')
+    expect(unpackCheckpoint(saved!).state).toEqual(world)
+  })
+  it('does not compact legacy pending when checkpoint storage is disabled', async () => {
+    vi.spyOn(playJournal, 'createPlayJournal').mockReturnValueOnce({
+      appendBatch: async () => { throw new Error('archive unavailable') }, readAll: async () => [],
+    })
+    const world = createGame(100016); world.life.openingSeen = true
+    // Controlled legacy fixture: inspect the pending passed to the public checkpoint boundary.
+    const envelope = JSON.parse(serialize(world, 100000))
+    envelope.playJournal = { version: 1, worldId: 'legacy-world', pending: [{ id: 'legacy-large', worldId: 'legacy-world', at: 100000,
+      kind: 'action', from: 480, to: 480, characterId: world.activeCharacterId, message: 'x'.repeat(400_000), events: [] }] }
+    saved = JSON.stringify(envelope)
+    const original = saved, checkpointSpy = vi.spyOn(playJournal, 'packCheckpoint')
+    storage.setItem.mockImplementation(() => { throw new Error('disabled') })
+    const game = useGameStore()
+    await vi.advanceTimersByTimeAsync(0)
+    expect(checkpointSpy.mock.calls.at(-1)![1].pending.map(record => record.id)).toEqual(['legacy-large'])
+    expect(game.pendingRecords).toBe(1)
+    expect(storage.setItem).toHaveBeenCalledTimes(1)
+    expect(saved).toBe(original)
+    expect(game.speed).toBe(0)
+    expect(game.saveError).toBe('存檔失敗：瀏覽器儲存空間不足或被停用，時間已暫停，請保留此頁。')
+    expect(game.message).toBe(game.saveError)
+    expect(game.journalError).not.toContain('較舊逐筆訊息與事件已移除')
+  })
   it('compacts oversized legacy pending data so reset persists under quota', async () => {
     const appendBatch = vi.fn(async () => { throw new Error('archive unavailable') })
     vi.spyOn(playJournal, 'createPlayJournal').mockReturnValueOnce({ appendBatch, readAll: async () => [] })
